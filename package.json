    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.16.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.31.0",
    "eslint-config-next": "15.4.4",
    "prisma": "6.12.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
